{
  "name": "cocos-challenge",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:local": "docker compose up --build",
    "start:dev": "tsc -p tsconfig.json && node dist/main.js",
    "openapi:generate": "tsc -p tsconfig.json && node dist/generate-openapi.js",
    "test": "jest --selectProjects unit --coverage",
    "test:integration": "jest --selectProjects integration",
    "lint": "eslint .",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.10",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
